APP_SECRET=change-me-to-a-long-random-string
DB_DSN="mysql:host=127.0.0.1;port=3306;dbname=mvr;charset=utf8mb4"
DB_USER=mvr
DB_PASSWORD=secret
TOKEN_TTL=1209600
# Comma separated origins allowed to call the API from the browser (e.g. the club website)
CORS_ORIGINS=https://www.banik-libusin.cz
# Storage for uploaded videos: local | ftp
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/var/www/mvr/backend/public/videos
STORAGE_PUBLIC_URL=https://video.banik-libusin.cz
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_ROOT=/videos

# Login throttling: after LOGIN_MAX_FAILURES failed logins from one IP within
# LOGIN_WINDOW_MINUTES the IP is refused until the window passes (0 = off).
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_MINUTES=15
# How long the login log (incl. IP addresses) is kept
AUTH_LOG_RETENTION_DAYS=180
# Behind a reverse proxy / load balancer: its IP(s), so X-Forwarded-For is trusted
TRUSTED_PROXIES=
